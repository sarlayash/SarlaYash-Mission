rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow reading user profiles so admins and public verification can view learners
      allow read: if true;
      
      // Allow users to create and update their own profile document, or admin
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'kapilnarula27july@gmail.com')
                   || request.auth == null;
    }

    match /communications/{commId} {
      // Allow reading and writing communications so admins can dispatch emails/texts and learners receive them real-time
      allow read, write: if true;
    }
    
    // Default fallback for any other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
